diff --git a/src/postgres_text_reader.cpp b/src/postgres_text_reader.cpp
index 1c75481..9894727 100644
--- a/src/postgres_text_reader.cpp
+++ b/src/postgres_text_reader.cpp
@@ -383,6 +383,22 @@ void PostgresTextReader::ConvertVector(Vector &source, Vector &target, const Pos
 	case LogicalTypeId::BLOB:
 		ConvertBlob(source, target, count);
 		break;
+	case LogicalTypeId::DECIMAL: {
+		auto strings = FlatVector::GetData<string_t>(source);
+		for (idx_t i = 0; i < count; i++) {
+			if (!FlatVector::IsNull(source, i)) {
+				auto str = strings[i];
+				auto sz = str.GetSize();
+				auto ptr = str.GetData();
+				if ((sz == 3 && memcmp(ptr, "NaN", 3) == 0) || (sz == 8 && memcmp(ptr, "Infinity", 8) == 0) ||
+				    (sz == 9 && memcmp(ptr, "-Infinity", 9) == 0)) {
+					FlatVector::SetNull(source, i, true);
+				}
+			}
+		}
+		VectorOperations::Cast(context, source, target, count);
+		break;
+	}
 	case LogicalTypeId::GEOMETRY:
 		ConvertGeometry(source, target, count);
 		break;
