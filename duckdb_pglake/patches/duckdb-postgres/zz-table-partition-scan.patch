+// Locks the parent, and with it the members, before any query takes the transaction snapshot, so
+// a DROP or TRUNCATE of a member either shows in the snapshot or waits for the scan. Returns
+// false when the role may not lock the parent, as with only column grants.
+static bool PostgresLockParent(ClientContext &context, PostgresConnection &con, const string &parent_name) {
+	if (con.TryQuery(context, "SAVEPOINT pg_lake_scan_lock; LOCK TABLE " + parent_name +
+	                              " IN ACCESS SHARE MODE; RELEASE SAVEPOINT pg_lake_scan_lock")) {
+		return true;
+	}
+	con.Execute(context, "ROLLBACK TO SAVEPOINT pg_lake_scan_lock");
+	return false;
