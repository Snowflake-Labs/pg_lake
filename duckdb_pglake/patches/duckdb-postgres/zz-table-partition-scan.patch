+// One row per leaf partition of every partitioned table in the schema, or only of `table` when it is
+// given.
+string PostgresTableSet::GetPartitionsQuery(const string &schema, const string &table) {
+	string query = R"(
+WITH RECURSIVE inh AS (
+    SELECT relation_class.oid AS root_oid, relation_class.oid
+    FROM pg_class relation_class
+    JOIN pg_namespace relation_namespace ON relation_namespace.oid = relation_class.relnamespace
+    WHERE relation_namespace.nspname = ${SCHEMA} ${CONDITION}
+      AND relation_class.relkind = 'p'
+  UNION ALL
+    SELECT inh.root_oid, inheritance.inhrelid
+    FROM pg_inherits inheritance
+    JOIN inh ON inheritance.inhparent = inh.oid
+)
+SELECT root_class.relname AS root_name,
+       relation_namespace.nspname AS member_schema,
+       relation_class.relname AS member_name,
+       pg_relation_size(relation_class.oid) / current_setting('block_size')::bigint AS relpages
+FROM inh
+JOIN pg_class root_class ON root_class.oid = inh.root_oid
+JOIN pg_class relation_class ON relation_class.oid = inh.oid
+JOIN pg_namespace relation_namespace ON relation_namespace.oid = relation_class.relnamespace
+WHERE relation_class.relkind IN ('r', 'm', 'f')
+ORDER BY root_name, member_schema, member_name;
+)";
+	string condition;
+	if (!table.empty()) {
+		condition = "AND relation_class.relname = " + KeywordHelper::WriteQuoted(table, '\'');
+	}
+	query = StringUtil::Replace(query, "${SCHEMA}", KeywordHelper::WriteQuoted(schema, '\''));
+	query = StringUtil::Replace(query, "${CONDITION}", condition);
+	return query;
+}
+
+// Run at scan time inside the scan's transaction: the members of `table` as they are in the scan
+// snapshot, plus whether scanning them one at a time is equivalent to querying the parent.
+// split_safe is false when row level security or a missing SELECT grant on a member would make a
+// direct member query see different rows than the parent query. prunable is true when a filtered
+// column is a partition key or appears in a CHECK constraint, so a parent query can skip members.
+string PostgresTableSet::GetScanMembersQuery(const string &schema, const string &table,
+                                             const vector<string> &filter_columns, bool has_partitioned_tables) {
+	string query = R"(
+WITH RECURSIVE inh AS (
+    SELECT relation_class.oid
+    FROM pg_class relation_class
+    JOIN pg_namespace relation_namespace ON relation_namespace.oid = relation_class.relnamespace
+    WHERE relation_namespace.nspname = ${SCHEMA} AND relation_class.relname = ${TABLE}
+  UNION ALL
+    SELECT inheritance.inhrelid
+    FROM pg_inherits inheritance
+    JOIN inh ON inheritance.inhparent = inh.oid
+),
+tree AS (
+    SELECT bool_and(has_table_privilege(inh.oid, 'SELECT') AND NOT relation_class.relrowsecurity) AS split_safe,
+           ${PRUNABLE} AS prunable
+    FROM inh
+    JOIN pg_class relation_class ON relation_class.oid = inh.oid
+)
+SELECT relation_namespace.nspname AS member_schema,
+       relation_class.relname AS member_name,
+       pg_relation_size(relation_class.oid) / current_setting('block_size')::bigint AS relpages,
+       tree.split_safe,
+       tree.prunable
+FROM inh
+JOIN pg_class relation_class ON relation_class.oid = inh.oid
+JOIN pg_namespace relation_namespace ON relation_namespace.oid = relation_class.relnamespace
+CROSS JOIN tree
+WHERE relation_class.relkind IN ('r', 'm', 'f')
+ORDER BY member_schema, member_name;
+)";
+	string prunable = "false";
+	if (!filter_columns.empty()) {
+		string columns;
