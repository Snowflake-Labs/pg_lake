+string PostgresTableSet::GetPartitionsQuery(const string &schema, const string &table) {
+	string query = R"(
+WITH RECURSIVE inh AS (
+    SELECT relation_class.oid, relation_class.relnamespace, relation_class.relname, relation_class.relkind
+    FROM pg_class relation_class
+    JOIN pg_namespace relation_namespace ON relation_namespace.oid = relation_class.relnamespace
+    WHERE relation_namespace.nspname = ${SCHEMA} AND relation_class.relname = ${TABLE}
+  UNION ALL
+    SELECT relation_class.oid, relation_class.relnamespace, relation_class.relname, relation_class.relkind
+    FROM pg_inherits inheritance
+    JOIN inh ON inheritance.inhparent = inh.oid
+    JOIN pg_class relation_class ON inheritance.inhrelid = relation_class.oid
+)
+SELECT relation_namespace.nspname AS partition_schema,
+       inh.relname AS partition_name,
+       pg_relation_size(inh.oid) / current_setting('block_size')::bigint AS relpages
+FROM inh
+JOIN pg_namespace relation_namespace ON relation_namespace.oid = inh.relnamespace
+WHERE inh.relkind != 'p' AND inh.relkind IN ('r', 'm', 'f')
+ORDER BY partition_schema, partition_name;
+)";
+	query = StringUtil::Replace(query, "${SCHEMA}", KeywordHelper::WriteQuoted(schema, '\''));
+	query = StringUtil::Replace(query, "${TABLE}", KeywordHelper::WriteQuoted(table, '\''));
+	return query;
+}
+
+vector<PostgresPartitionInfo> PostgresTableSet::GetPartitions(ClientContext &context, PostgresConnection &connection,
+                                                              const string &schema_name, const string &table_name) {
+	auto query = GetPartitionsQuery(schema_name, table_name);
+	auto result = connection.Query(context, query);
+	auto row_count = result->Count();
+	vector<PostgresPartitionInfo> partitions;
+	for (idx_t row_index = 0; row_index < row_count; row_index++) {
+		PostgresPartitionInfo partition_info;
+		partition_info.schema_name = result->GetString(row_index, 0);
+		partition_info.table_name = result->GetString(row_index, 1);
+		partition_info.approx_num_pages = result->IsNull(row_index, 2) ? 0 : result->GetInt64(row_index, 2);
+		partitions.push_back(std::move(partition_info));
+	}
+	return partitions;
+}
+
+vector<PostgresPartitionInfo> PostgresTableSet::GetPartitions(PostgresTransaction &transaction,
+                                                              const string &schema_name, const string &table_name) {
+	auto query = GetPartitionsQuery(schema_name, table_name);
+	auto result = transaction.Query(query);
+	auto row_count = result->Count();
+	vector<PostgresPartitionInfo> partitions;
+	for (idx_t row_index = 0; row_index < row_count; row_index++) {
+		PostgresPartitionInfo partition_info;
+		partition_info.schema_name = result->GetString(row_index, 0);
+		partition_info.table_name = result->GetString(row_index, 1);
+		partition_info.approx_num_pages = result->IsNull(row_index, 2) ? 0 : result->GetInt64(row_index, 2);
+		partitions.push_back(std::move(partition_info));
+	}
+	return partitions;
+}
