+//! Byte accounting for the output chunk currently being filled. Rows are only ever added
+//! while Reached() is false, so a chunk always holds at least one row - a single row larger
+//! than the bound is emitted on its own rather than being rejected.
+struct PostgresChunkSizeLimit {
+	//! Bound on the payload bytes accumulated into a single output chunk. Zero means
+	//! unbounded, i.e. a chunk is only bounded by STANDARD_VECTOR_SIZE rows.
+	idx_t max_bytes = 0;
+	//! Payload bytes accumulated into the current output chunk
+	idx_t bytes = 0;
+
+	void Add(idx_t n) {
+		bytes += n;
+	}
+	bool Reached() const {
+		return max_bytes > 0 && bytes >= max_bytes;
+	}
+};
