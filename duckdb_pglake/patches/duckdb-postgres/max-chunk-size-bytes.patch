 	virtual void BeginCopy(const string &sql) = 0;
 	virtual PostgresReadResult Read(DataChunk &result) = 0;
 
+	//! Bound on the number of payload bytes we accumulate into a single output chunk.
+	//! Zero means unbounded, i.e. a chunk is only bounded by STANDARD_VECTOR_SIZE rows.
+	void SetMaxChunkSizeBytes(idx_t bytes) {
+		max_chunk_size_bytes = bytes;
+	}
+	//! Called by the scan whenever the executor hands us a fresh output chunk
+	void ResetChunkSize() {
+		chunk_size_bytes = 0;
+	}
+	//! Whether the current output chunk has reached the byte bound. Rows are only ever
+	//! added while this is false, so a chunk always holds at least one row - a single
+	//! row larger than the bound is emitted on its own rather than being rejected.
+	bool ChunkSizeLimitReached() const {
+		return max_chunk_size_bytes > 0 && chunk_size_bytes >= max_chunk_size_bytes;
+	}
+
+protected:
+	void AddChunkSizeBytes(idx_t bytes) {
+		chunk_size_bytes += bytes;
+	}
+
 protected:
 	PostgresConnection &con;
 	const vector<column_t> &column_ids;
 	const PostgresBindData &bind_data;
+
+private:
+	idx_t max_chunk_size_bytes = 0;
+	idx_t chunk_size_bytes = 0;
 };
 
 } // namespace duckdb
