 struct PostgresBindData : public FunctionData {
 	static constexpr const idx_t DEFAULT_PAGES_PER_TASK = 1000;
+	//! Default bound on the payload bytes accumulated into one output chunk. A chunk is
+	//! the smallest unit the Parquet writer downstream can flush a row group at, so a
+	//! chunk of 2048 wide rows would otherwise overshoot the configured row group size
+	//! by an unbounded factor. Bounding it bounds a row group at its configured size plus
+	//! one chunk. The bound is charged in Postgres bytes, which for arrays of very short
+	//! strings can be 8x smaller than the in-memory size the writer thresholds on, so it
+	//! is kept well below a typical row group size rather than equal to one. 16MB over
+	//! 2048 rows is still 8KB per row, so ordinary tables keep yielding full chunks.
+	static constexpr const idx_t DEFAULT_MAX_CHUNK_SIZE_BYTES = 16ULL * 1024 * 1024;
 
