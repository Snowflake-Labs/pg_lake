+//! Gives the top-level columns of a file written without field ids the field ids their names map to, as Iceberg
+//! readers do with a table's name mapping. A file with field ids keeps them, mapped names or not.
+static void AssignFieldIdsFromMappedNames(vector<MultiFileColumnDefinition> &columns,
+                                          const vector<ParquetColumnDefinition> &schema) {
+	unordered_map<string, Value> field_ids;
+	for (auto &column : schema) {
+		if (column.identifier.type().id() != LogicalTypeId::INTEGER) {
+			continue;
+		}
+		for (auto &name : column.mapped_names) {
+			field_ids.emplace(name, column.identifier);
+		}
+	}
+	if (field_ids.empty()) {
+		return;
+	}
+	for (auto &column : columns) {
+		if (!column.identifier.IsNull() && column.GetIdentifierFieldId() != MultiFileReader::ORDINAL_FIELD_ID) {
+			return;
+		}
+	}
+	for (auto &column : columns) {
+		if (!column.identifier.IsNull()) {
+			continue;
+		}
+		auto entry = field_ids.find(column.name);
+		if (entry != field_ids.end()) {
+			column.identifier = entry->second;
+		}
+	}
+}
