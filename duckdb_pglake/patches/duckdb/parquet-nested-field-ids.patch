+//! Gives a column of the schema option the nested fields of its type, with their field ids, so that the fields of
+//! each file are matched by field id at every level rather than cast by name.
+static void AddNestedFieldIds(MultiFileColumnDefinition &column, const vector<ParquetNestedField> &nested) {
+	auto parent_id = column.GetIdentifierFieldId();
+	auto add_child = [&](const string &name, const LogicalType &type, const string &position) {
+		for (auto &field : nested) {
+			if (field.parent_id == parent_id && field.name == position) {
+				MultiFileColumnDefinition child(name, type);
+				child.identifier = Value::INTEGER(field.field_id);
+				child.default_expression = make_uniq<ConstantExpression>(Value(type));
+				AddNestedFieldIds(child, nested);
+				column.children.push_back(std::move(child));
+				return;
+			}
+		}
+		throw InvalidInputException("'schema' has no field id for \"%s\" in the field with id %d", position,
+		                            parent_id);
+	};
+	switch (column.type.id()) {
+	case LogicalTypeId::STRUCT:
+		for (auto &child : StructType::GetChildTypes(column.type)) {
+			add_child(child.first, child.second, child.first);
+		}
+		break;
+	case LogicalTypeId::LIST:
+		add_child("element", ListType::GetChildType(column.type), "element");
+		break;
+	case LogicalTypeId::MAP:
+		add_child("key", MapType::KeyType(column.type), "key");
+		add_child("value", MapType::ValueType(column.type), "value");
+		break;
+	default:
+		break;
+	}
+}
