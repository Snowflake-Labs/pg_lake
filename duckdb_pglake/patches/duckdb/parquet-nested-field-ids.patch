+//! How a file's column nests its fields, matched by field id, compared with the schema's column. Iceberg cannot change
+//! how a field nests, but pg_lake writes a clamped multidimensional array as a list of lists into a list column, whose
+//! values are all NULL; such a list is cast as a whole, as a column without nested field ids is.
+enum class NestingComparison : uint8_t { MATCHES, LIST_FOR_SCALAR, DIFFERS };
+
+static NestingComparison CompareNesting(const MultiFileColumnDefinition &global_column,
+                                        const MultiFileColumnDefinition &local_column) {
+	if (global_column.children.empty()) {
+		if (global_column.type.IsNested() || !local_column.type.IsNested()) {
+			return NestingComparison::MATCHES;
+		}
+		return local_column.type.id() == LogicalTypeId::LIST ? NestingComparison::LIST_FOR_SCALAR
+		                                                     : NestingComparison::DIFFERS;
+	}
+	if (local_column.type.id() != global_column.type.id()) {
+		return NestingComparison::DIFFERS;
+	}
+	auto result = NestingComparison::MATCHES;
+	auto compare_child = [&result](const MultiFileColumnDefinition &global_child,
+	                               const vector<MultiFileColumnDefinition> &local_children) {
+		for (auto &local_child : local_children) {
+			if (!local_child.identifier.IsNull() && local_child.identifier == global_child.identifier) {
+				result = MaxValue(result, CompareNesting(global_child, local_child));
+				return;
+			}
+		}
+	};
+	switch (global_column.type.id()) {
+	case LogicalTypeId::STRUCT:
+	case LogicalTypeId::LIST:
+		for (auto &global_child : global_column.children) {
+			compare_child(global_child, local_column.children);
+		}
+		return result;
+	case LogicalTypeId::MAP:
+		if (local_column.children.size() != 1) {
+			return NestingComparison::DIFFERS;
+		}
+		for (auto &global_child : global_column.children) {
+			compare_child(global_child, local_column.children[0].children);
+		}
+		return result;
+	default:
+		return result;
+	}
+}
