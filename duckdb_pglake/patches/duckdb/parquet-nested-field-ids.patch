+//! Gives the fields nested in a column of a file written without field ids the ids of the schema option's nested
+//! fields under the same parent: a struct field by one of the names the name mapping gives it, a list element and a
+//! map key and value by their position.
+static void AssignNestedFieldIds(MultiFileColumnDefinition &column, const vector<ParquetNestedField> &nested) {
+	if (column.identifier.IsNull() || column.identifier.type().id() != LogicalTypeId::INTEGER) {
+		return;
+	}
+	auto parent_id = column.GetIdentifierFieldId();
+	auto assign = [&](MultiFileColumnDefinition &child, const char *position) {
+		if (child.identifier.IsNull()) {
+			for (auto &field : nested) {
+				if (field.parent_id != parent_id) {
+					continue;
+				}
+				bool matches = position ? field.name == position
+				                        : std::find(field.names.begin(), field.names.end(), child.name) !=
+				                              field.names.end();
+				if (matches) {
+					child.identifier = Value::INTEGER(field.field_id);
+					break;
+				}
+			}
+		}
+		AssignNestedFieldIds(child, nested);
+	};
+	switch (column.type.id()) {
+	case LogicalTypeId::STRUCT:
+		for (auto &child : column.children) {
+			assign(child, nullptr);
+		}
+		break;
+	case LogicalTypeId::LIST:
+		if (column.children.size() == 1) {
+			assign(column.children[0], "element");
+		}
+		break;
+	case LogicalTypeId::MAP:
+		if (column.children.size() == 1 && column.children[0].children.size() == 2) {
+			assign(column.children[0].children[0], "key");
+			assign(column.children[0].children[1], "value");
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+static void AssignNestedFieldIds(vector<MultiFileColumnDefinition> &columns,
+                                 const vector<ParquetColumnDefinition> &schema) {
+	for (auto &column : columns) {
+		if (column.identifier.IsNull() || column.identifier.type().id() != LogicalTypeId::INTEGER) {
+			continue;
+		}
+		for (auto &definition : schema) {
+			if (!definition.nested_fields.empty() && definition.identifier == column.identifier) {
+				AssignNestedFieldIds(column, definition.nested_fields);
+				break;
+			}
+		}
+	}
