+// Look the value of field_id in file up in the entries ParseFileConstants
+// sorted by file
+static bool FindFileConstant(const Value &file_constants, const string &file, int32_t field_id, Value &result) {
+	auto &entries = ListValue::GetChildren(file_constants);
+	idx_t lower = 0;
+	idx_t upper = entries.size();
+	while (lower < upper) {
+		idx_t middle = lower + (upper - lower) / 2;
+		if (StringValue::Get(StructValue::GetChildren(entries[middle])[0]) < file) {
+			lower = middle + 1;
+		} else {
+			upper = middle;
+		}
+	}
+	for (idx_t i = lower; i < entries.size(); i++) {
+		auto &entry = StructValue::GetChildren(entries[i]);
+		if (StringValue::Get(entry[0]) != file) {
+			break;
+		}
+		if (IntegerValue::Get(entry[1]) == field_id) {
+			result = entry[2];
+			return true;
+		}
+	}
+	return false;
+}
