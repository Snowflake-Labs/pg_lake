+static string UnescapeFileConstant(const string &text) {
+	string result;
+	for (idx_t i = 0; i < text.size(); i++) {
+		if (text[i] != '\\' || i + 1 == text.size()) {
+			result += text[i];
+			continue;
+		}
+		i++;
+		result += text[i] == 't' ? '\t' : text[i] == 'n' ? '\n' : text[i];
+	}
+	return result;
+}
+
+// Parse a file_constants option: a line per file and field id that file has
+// a constant for, "<file>\t<field id>\t<value>", where a value of \N is NULL
+// and \\, \t and \n stand for a backslash, tab and newline. One string parses
+// much faster than a nested literal with an entry per file. Returns the
+// entries as a LIST of STRUCT(file, field_id, value), sorted by file.
+static Value ParseFileConstants(const string &text) {
+	struct FileConstant {
+		string file;
+		int32_t field_id;
+		Value value;
+	};
+	vector<FileConstant> constants;
+	idx_t start = 0;
+	while (start < text.size()) {
+		auto end = text.find('\n', start);
+		if (end == string::npos) {
+			end = text.size();
+		}
+		auto line = text.substr(start, end - start);
+		start = end + 1;
+		if (line.empty()) {
+			continue;
+		}
+		auto first_tab = line.find('\t');
+		auto second_tab = first_tab == string::npos ? string::npos : line.find('\t', first_tab + 1);
+		int32_t field_id;
+		if (second_tab == string::npos ||
+		    !TryCast::Operation(string_t(line.substr(first_tab + 1, second_tab - first_tab - 1)), field_id, true)) {
+			throw InvalidInputException("'file_constants' line \"%s\" is not a file, a field id and a value", line);
+		}
+		auto value = line.substr(second_tab + 1);
+		constants.push_back({UnescapeFileConstant(line.substr(0, first_tab)), field_id,
+		                     value == "\\N" ? Value(LogicalType::VARCHAR) : Value(UnescapeFileConstant(value))});
+	}
+	std::stable_sort(constants.begin(), constants.end(),
+	                 [](const FileConstant &a, const FileConstant &b) { return a.file < b.file; });
+
+	auto entry_type = LogicalType::STRUCT(
+	    {{"file", LogicalType::VARCHAR}, {"field_id", LogicalType::INTEGER}, {"value", LogicalType::VARCHAR}});
+	vector<Value> entries;
+	for (auto &constant : constants) {
+		entries.push_back(Value::STRUCT(
+		    {{"file", Value(constant.file)}, {"field_id", Value::INTEGER(constant.field_id)}, {"value", constant.value}}));
+	}
+	return Value::LIST(entry_type, std::move(entries));
+}
