+// Look the value of field_id in file up in a file_constants MAP, whose file
+// names ParseOption checked are in ascending order
+static bool FindFileConstant(const Value &file_constants, const string &file, int32_t field_id, Value &result) {
+	auto &files = MapValue::GetChildren(file_constants);
+	idx_t lower = 0;
+	idx_t upper = files.size();
+	while (lower < upper) {
+		idx_t middle = lower + (upper - lower) / 2;
+		auto &entry = StructValue::GetChildren(files[middle]);
+		auto &name = StringValue::Get(entry[0]);
+		if (name < file) {
+			lower = middle + 1;
+		} else if (file < name) {
+			upper = middle;
+		} else {
+			for (auto &field : MapValue::GetChildren(entry[1])) {
+				auto &pair = StructValue::GetChildren(field);
+				if (IntegerValue::Get(pair[0]) == field_id) {
+					result = pair[1];
+					return true;
+				}
+			}
+			return false;
+		}
+	}
+	return false;
+}
