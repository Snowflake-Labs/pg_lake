+//! Whether a column is the file_row_number column, which has a field id in files written without any
+static bool IsFileRowNumberColumn(const MultiFileColumnDefinition &column) {
+	return !column.identifier.IsNull() && column.identifier.type().id() == LogicalTypeId::INTEGER &&
+	       column.GetIdentifierFieldId() == MultiFileReader::ORDINAL_FIELD_ID;
+}
+
+static bool HasFieldIds(const vector<MultiFileColumnDefinition> &columns) {
+	for (auto &column : columns) {
+		if (!column.identifier.IsNull() && !IsFileRowNumberColumn(column)) {
+			return true;
+		}
+	}
+	return false;
+}
