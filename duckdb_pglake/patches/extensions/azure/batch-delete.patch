+/*
+ * Azure Blob Storage limits a batch request to 256 subrequests.
+ */
+static constexpr idx_t AZURE_BATCH_DELETE_MAX_KEYS = 256;
+
+/*
+ * RemoveFiles deletes many blobs using the Azure Blob Batch API, sending up to
+ * AZURE_BATCH_DELETE_MAX_KEYS delete subrequests per SubmitBatch call instead
+ * of one HTTP request per blob. All paths must be azure:// or az:// URLs.
+ *
+ * Errors on individual blobs are checked via the DeferredResponse from
+ * each subrequest. BlobNotFound (404) is tolerated -- a blob that is already
+ * gone is not an error. Any other failure throws right away, leaving the
+ * remaining batches and containers unattempted, as the S3 path does: the
+ * pg_lake retries a failed request one path at a time.
+ */
+void AzureBlobStorageFileSystem::RemoveFiles(const vector<string> &paths, optional_ptr<FileOpener> opener) {
+	if (paths.empty()) {
+		return;
+	}
+
+	/*
+	 * Group paths by container, because SubmitBatch targets one container at a
+	 * time (BlobContainerBatch is scoped to its BlobContainerClient), and by
+	 * what the storage client is built from: the secret that matches the path,
+	 * and the account and endpoint when the URL names them. Paths in different
+	 * accounts can have containers of the same name.
+	 */
+	struct ContainerBatch {
+		string first_path;
+		vector<AzureParsedUrl> container_paths;
+	};
+	using BatchKey = std::tuple<string, string, string, string, string>;
+	std::map<BatchKey, ContainerBatch> batches;
+
+	for (const string &path : paths) {
+		auto parsed = ParseUrl(path);
+
+		string secret_storage;
+		string secret_name;
+		auto secret_match = LookupSecret(opener, path);
+		if (secret_match.HasMatch()) {
+			secret_storage = secret_match.secret_entry->storage_mode;
+			secret_name = secret_match.GetSecret().GetName();
+		}
+
+		BatchKey key {secret_storage, secret_name, parsed.storage_account_name, parsed.endpoint, parsed.container};
+		auto &batch = batches[key];
+		if (batch.container_paths.empty()) {
+			batch.first_path = path;
+		}
+		batch.container_paths.push_back(std::move(parsed));
+	}
+
+	for (auto &entry : batches) {
+		const string &container_name = std::get<4>(entry.first);
+		vector<AzureParsedUrl> &container_paths = entry.second.container_paths;
+
+		/*
+		 * Every path in the group gets the same client, so build it from the
+		 * first path as the caller passed it.
+		 */
+		auto storage_context = GetOrCreateStorageContext(opener, entry.second.first_path, container_paths[0]);
+		auto container_client =
+		    storage_context->As<AzureBlobContextState>().GetBlobContainerClient(container_name);
+
+		for (idx_t begin = 0; begin < container_paths.size();
+		     begin += AZURE_BATCH_DELETE_MAX_KEYS) {
+			idx_t end = std::min<idx_t>(begin + AZURE_BATCH_DELETE_MAX_KEYS,
+			                            container_paths.size());
+
+			auto batch = container_client.CreateBatch();
+			vector<Azure::Storage::DeferredResponse<Azure::Storage::Blobs::Models::DeleteBlobResult>>
+			    deferred_responses;
+			deferred_responses.reserve(end - begin);
+
+			for (idx_t i = begin; i < end; i++) {
+				deferred_responses.push_back(batch.DeleteBlob(container_paths[i].path));
+			}
+
+			try {
+				container_client.SubmitBatch(batch);
+			} catch (const Azure::Storage::StorageException &e) {
+				throw IOException(
+				    "AzureBlobStorageFileSystem batch delete in container '%s' "
+				    "failed with %s Reason Phrase: %s",
+				    container_name, e.ErrorCode, e.ReasonPhrase);
+			}
+
+			for (idx_t i = 0; i < deferred_responses.size(); i++) {
+				try {
+					deferred_responses[i].GetResponse();
+				} catch (const Azure::Storage::StorageException &e) {
+					if (e.StatusCode == Azure::Core::Http::HttpStatusCode::NotFound) {
+						continue;
+					}
+					throw IOException(
+					    "AzureBlobStorageFileSystem batch delete of '%s' "
+					    "failed with %s Reason Phrase: %s",
+					    container_paths[begin + i].path, e.ErrorCode, e.ReasonPhrase);
+				}
+			}
+		}
+	}
+}
