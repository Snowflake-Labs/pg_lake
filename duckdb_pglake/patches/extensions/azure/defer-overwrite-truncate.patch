-void AzureBlobStorageFileHandle::Sync() {
+void AzureBlobStorageFileHandle::Sync(bool close) {
 	if (!(flags.OpenForWriting() || flags.OpenForAppending())) {
 		return;
 	}
 	try {
+		// An overwrite has left the destination alone so far (no truncate at open), so replace it
+		// in a single Put Blob if the whole file still fits in the write buffer. That covers a
+		// small fixed-path file like catalog.json, and an overwrite that writes no bytes at all.
+		// Only on close: bytes sent this way are not in the block list a later commit rebuilds.
+		if (close && overwrite_pending && staged_block_count == 0) {
+			auto body_stream = Azure::Core::IO::MemoryBodyStream(write_buffer.get(), write_buffer_offset);
+			auto res = blob_client.Upload(body_stream);
+			last_modified = AzureBlobStorageFileSystem::ToTimestamp(res.Value.LastModified);
+			write_buffer_offset = 0;
+			overwrite_pending = false;
+			return;
+		}
 		StageWriteBuffer();
 		if (staged_block_count == 0) {
 			return;
@@ -108,6 +120,8 @@ void AzureBlobStorageFileHandle::Sync() {
 		last_modified = AzureBlobStorageFileSystem::ToTimestamp(res.Value.LastModified);
 		committed_block_count += staged_block_count;
 		staged_block_count = 0;
+		// The block list that just landed is the replacement.
+		overwrite_pending = false;
 	} catch (const Azure::Storage::StorageException &e) {
 		throw IOException("AzureBlobStorageFileSystem FileSync of '%s' failed with %s Reason Phrase: %s", GetPath(),
