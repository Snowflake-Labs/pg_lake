 		set_props(false, 0, ToTimestamp(res_create.Value.LastModified));
 	};
-	auto truncate_file = create_file;
 
 	try {
 		auto res_props = afh.blob_client.GetProperties();
@@ -315,7 +328,10 @@ void AzureBlobStorageFileSystem::LoadRemoteFileInfo(AzureFileHandle &handle) {
 			throw IOException("AzureBlobStorageFileSystem will not open file: '%s', ExclusiveCreate specified "
 			                  "while file already exists.");
 		} else if (afh.flags.OpenForWriting() && afh.flags.OverwriteExistingFile()) {
-			return truncate_file();
+			// Truncate when the new bytes are committed, not now: a CommitBlockList({}) here
+			// publishes a durable zero-length blob for the rest of the write.
+			afh.overwrite_pending = true;
+			return set_props(false, 0, ToTimestamp(res_props.Value.LastModified));
 		}
 		// NOTE: honor convention for S3/Azure "foo/" empty file -> "foo" dir marker
 		auto is_dir = StringUtil::EndsWith(afh.GetPath(), "/");
@@ -332,6 +348,11 @@ void AzureBlobStorageFileSystem::LoadRemoteFileInfo(AzureFileHandle &handle) {
 	} catch (const Azure::Storage::StorageException &e) {
 		if (int(e.StatusCode) == 404 && afh.flags.OpenForWriting() &&
 		    (afh.flags.OverwriteExistingFile() || afh.flags.CreateFileIfNotExists())) {
+			if (afh.flags.OverwriteExistingFile()) {
+				// Same for a first write: a reader should get 404 until the bytes are there.
+				afh.overwrite_pending = true;
+				return set_props(false, 0, timestamp_t(0));
+			}
 			return create_file();
 		}
 		throw;
