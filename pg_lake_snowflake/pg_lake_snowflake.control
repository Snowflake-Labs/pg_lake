# pg_lake_snowflake extension
comment = 'Attach Snowflake tables as foreign tables'
default_version = '3.5'
module_pathname = '$libdir/pg_lake_snowflake'
relocatable = false
schema = pg_catalog
requires = 'pg_lake_iceberg'
