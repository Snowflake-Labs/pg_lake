# pg_lake_timeseries extension
comment = 'Time-series tables that keep recent data in PostgreSQL and history in Iceberg'
default_version = '3.4'
module_pathname = '$libdir/pg_lake_timeseries'
relocatable = false
schema = pg_catalog
requires = 'pg_extension_base,pg_lake_engine,pg_lake_iceberg,pg_lake_table'
#!shared_preload_libraries = '$libdir/pg_lake_engine,$libdir/pg_lake_iceberg,$libdir/pg_lake_table,$libdir/pg_lake_timeseries'
